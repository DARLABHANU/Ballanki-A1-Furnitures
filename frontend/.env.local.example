# Browser requests stay same-origin; Next.js proxies /api/* to the backend.
NEXT_PUBLIC_API_URL=/api/v1
# Local development. In Docker use http://backend:8000; in production use the backend's HTTPS URL.
BACKEND_URL=http://127.0.0.1:8000
