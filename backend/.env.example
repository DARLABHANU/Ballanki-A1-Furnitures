PORT=8000
# Local development binds only to this machine. Container deployments set HOST=0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ratnamayuri
# Generate a random secret of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
LOCAL_EMAIL_OUTBOX=1
ADMIN_EMAIL=
ADMIN_PASSWORD=
