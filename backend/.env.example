PORT=8000
# Local development binds only to this machine. Container deployments set HOST=0.0.0.0.
HOST=127.0.0.1
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ballanki
MONGODB_DB_NAME=ballanki
# Generate a random secret of at least 32 characters for each environment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
LOCAL_EMAIL_OUTBOX=true
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional DNS override when local SRV lookups fail; omit when system DNS works.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Cloudinary credentials belong only on the backend (Render).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_ID=1086302940000-u41rh4el2k8qmmmonsp90v2lssjq9v7b.apps.googleusercontent.com

# Gmail API transactional email (all credentials are backend-only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM=Ballanki A1 Furnitures <ballankia1furnitures@gmail.com>
EMAIL_REPLY_TO=ballankia1furnitures@gmail.com
EMAIL_WEBSITE_URL=https://ballanki-a1-furnitures.vercel.app
ADMIN_NOTIFICATION_EMAIL=ballankia1furnitures@gmail.com
